{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@spec-framework/cli/plugin": ["./src/plugin/index.ts"]
    },
    "types": ["bun"]
  },
  "include": ["src", "bin", "tests", "plugin", "scripts"],
  "exclude": ["node_modules", "dist", "spec", "tmp"]
}
